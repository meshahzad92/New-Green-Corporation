# ============================================
# AgriManage Pro - Frontend Environment Configuration
# ============================================

# Backend API Configuration
# Vite exposes only variables prefixed with VITE_ to frontend code.
VITE_API_URL=http://localhost:8000/api/v1

# Development Notes:
# 1. Copy this file to .env for local development.
# 2. Restart the frontend dev server after changing .env values.
# 3. For production, update VITE_API_URL to your deployed backend API URL.
